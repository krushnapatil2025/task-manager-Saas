# ── Supabase ────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# ── Google Drive — Service Account (Edge Function) ───────────────
VITE_GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account",...}
VITE_GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id

# ── Google Drive — OAuth2 (client-side upload) ───────────────────
VITE_GOOGLE_DRIVE_CLIENT_ID=your_oauth2_client_id.apps.googleusercontent.com
VITE_GOOGLE_DRIVE_CLIENT_SECRET=your_oauth2_client_secret
VITE_GOOGLE_DRIVE_REFRESH_TOKEN=your_oauth2_refresh_token

# ── Admin Registration Token ─────────────────────────────────────
VITE_ADMIN_INVITE_TOKEN=change_this_to_a_strong_secret

# ── Brevo Email ──────────────────────────────────────────────────
VITE_BREVO_API_KEY=your_brevo_api_key
VITE_SENDER_EMAIL=you@yourdomain.com
VITE_SENDER_NAME=Strideo
VITE_APP_URL=http://localhost:5173

# ── Super Admin ──────────────────────────────────────────────────
VITE_SUPER_ADMIN_EMAIL=superadmin@yourdomain.com
VITE_SUPER_ADMIN_PASSWORD=YourStrongPassword
VITE_SUPER_ADMIN_SECRET=your_super_admin_secret

# ── AI Assistant (Groq) ──────────────────────────────────────────
VITE_GROQ_API_KEY=your_groq_api_key
